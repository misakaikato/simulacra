{
	"name": "@misakaikato/simulacra",
	"version": "0.1.0",
	"description": "Typed, event-sourced LLM social simulation kernel with a robustness audit harness",
	"license": "Apache-2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/misakaikato/simulacra.git"
	},
	"bin": {
		"simulacra": "src/cli/index.ts"
	},
	"exports": {
		".": "./src/index.ts"
	},
	"files": [
		"src",
		"gui/dist",
		"examples",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"bun": ">=1.3"
	},
	"scripts": {
		"check": "tsc --noEmit && tsc --noEmit -p gui",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test",
		"simulacra": "bun src/cli/index.ts",
		"build:gui": "vite build --config gui/vite.config.ts",
		"dev:gui": "vite --config gui/vite.config.ts",
		"dev:mock": "bun gui/dev-mock.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"citty": "0.2.2",
		"hono": "^4.13.5",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.9.1",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^5",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2"
	}
}
