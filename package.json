{
	"name": "@misakaikato/simulacra",
	"version": "0.1.0",
	"description": "Typed, event-sourced kernel for LLM-driven social simulation with a built-in robustness-audit harness. CLI, HTTP API, MCP server and GUI.",
	"license": "Apache-2.0",
	"type": "module",
	"bin": {
		"simulacra": "src/cli/index.ts"
	},
	"types": "./src/index.ts",
	"exports": {
		".": {
			"types": "./src/index.ts",
			"bun": "./src/index.ts",
			"default": "./src/index.ts"
		}
	},
	"files": [
		"src",
		"gui/dist",
		"examples",
		"LICENSE",
		"README.md"
	],
	"engines": {
		"bun": ">=1.3"
	},
	"publishConfig": {
		"access": "public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/misakaikato/simulacra.git"
	},
	"homepage": "https://github.com/misakaikato/simulacra#readme",
	"bugs": {
		"url": "https://github.com/misakaikato/simulacra/issues"
	},
	"keywords": [
		"llm",
		"agent-based-modeling",
		"social-simulation",
		"multi-agent",
		"robustness",
		"audit",
		"bun",
		"typescript",
		"mcp"
	],
	"scripts": {
		"check": "tsc --noEmit && tsc --noEmit -p gui",
		"lint": "eslint .",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "bun test",
		"simulacra": "bun src/cli/index.ts",
		"build:gui": "vite build --config gui/vite.config.ts",
		"dev:gui": "vite --config gui/vite.config.ts",
		"dev:mock": "bun gui/dev-mock.ts",
		"prepublishOnly": "bun run check && bun run lint && bun test && bun run build:gui"
	},
	"dependencies": {
		"@modelcontextprotocol/sdk": "^1.30.0",
		"citty": "0.2.2",
		"hono": "^4.13.5",
		"yaml": "^2.9.0",
		"zod": "^4.5.4"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/bun": "^1.4.0",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.5",
		"@vitejs/plugin-react": "^6.1.1",
		"eslint": "^10.9.1",
		"prettier": "^3.9.6",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"typescript": "^5",
		"typescript-eslint": "^8.69.0",
		"vite": "^8.2.2"
	}
}
